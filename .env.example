# DeepSeek大模型配置
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_with_your_deepseek_api_key
LLM_MODEL=deepseek-v4-flash

# ModelScope向量模型配置
EMBEDDING_BASE_URL=https://api-inference.modelscope.cn/v1
EMBEDDING_API_KEY=replace_with_your_modelscope_api_key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_BATCH_SIZE=10

# 数据库和向量索引
DATABASE_PATH=database/security_management_demo.db
VECTOR_INDEX_PATH=database/vector_index/security_knowledge

# Agent运行限制
LLM_MAX_ROUNDS=6
LLM_MAX_TOOL_CALLS=10

# 增加检查点配置
CHECKPOINT_DATABASE_PATH=database/runtime/langgraph_checkpoints.db
LANGGRAPH_STRICT_MSGPACK=true

JWT_SECRET_KEY=这里换成随机生成的JWT密钥
DEMO_AUTH_PASSWORD=123456
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# 智谱GLM多模态模型配置
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=replace_with_your_zhipu_api_key
VISION_MODEL=glm-4.6v-flash